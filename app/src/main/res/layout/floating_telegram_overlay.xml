<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Floating Bubble Mode: Small icon on screen staying on top of other apps -->
    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@android:drawable/btn_default"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ImageView
            android:id="@+id/img_bubble_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_dialog_info"
            android:contentDescription="Telegram Bot Floating Bubble" />
    </LinearLayout>

    <!-- 2. Expandable Panel: 320dp width x 450dp height representing Telegram Bot section -->
    <LinearLayout
        android:id="@+id/layout_expanded"
        android:layout_width="320dp"
        android:layout_height="450dp"
        android:orientation="vertical"
        android:background="#F20A1422"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Top Controls: Title, Minimize Button, and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_dialog_email"
                android:contentDescription="Telegram Bot Icon" />

            <TextView
                android:id="@+id/tv_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Telegram Bot Panel"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 3. Minimize Control: collapses panel back to small bubble -->
            <ImageButton
                android:id="@+id/btn_minimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:drawable/screen_background_dark_transparent"
                android:src="@android:drawable/arrow_down_float"
                android:contentDescription="Minimize to Bubble" />

            <!-- 3. Close Control: stops overlay service -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@android:drawable/screen_background_dark_transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close Overlay" />
        </LinearLayout>

        <!-- Telegram Bot Status Pill -->
        <TextView
            android:id="@+id/tv_bot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E3858"
            android:padding="6dp"
            android:text="⚡ Bot Active: Ready to forward OTPs"
            android:textColor="#00E676"
            android:textSize="11sp" />

        <!-- Bot Quick Commands & Log Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bot_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[Telegram Bot Console]\nListening for incoming OTPs...\n/start - Start Bot\n/otp - Last Received OTP\n/balance - User Balance\n/numbers - Active Numbers"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
