<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly trust ONLY system-preinstalled root CAs.
         Blocks all user-installed MITM sniffer CA certificates (HttpCanary, Reqable, Burp, Charles, Fiddler, PCAPdroid)
         while preserving compatibility with proxy IP tests and standard VPN routing. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
